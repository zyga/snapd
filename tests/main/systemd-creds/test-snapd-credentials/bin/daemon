#!/bin/sh
set -xeu
(
    # Look for the credentials environment variable
    echo "CREDENTIALS_DIRECTORY=${CREDENTIALS_DIRECTORY:-}"
    # Look at individual credentials.
    if [ -d "${CREDENTIALS_DIRECTORY:-}" ]; then
        find "$CREDENTIALS_DIRECTORY" -type f -exec cat {} \;
    fi
) >$SNAP_COMMON/log

exit 0
